name: Weekly calendar update

on:
  schedule:
    # Lunes 12:00 UTC = 09:00 Argentina (GMT-3)
    - cron: "0 12 * * 1"
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install deps
        run: pip install -r requirements.txt

      - name: Generate calendar into /pages
        run: python generate_calendar.py

      - name: Commit & push changes
        run: |
          git config user.name "calendar-bot"
          git config user.email "calendar-bot@users.noreply.github.com"
          git add pages/calendar.ics pages/last_updated.txt
          git commit -m "Weekly calendar update" || exit 0
          git push
